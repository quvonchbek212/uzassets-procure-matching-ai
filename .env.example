# Application Settings
APP_NAME=UzAssets Limit Article Matching
PORT=8001
LOG_LEVEL=INFO

# AI Provider Selection: GEMINI or GEMMA (via vLLM)
LAM_AI_MODEL=GEMINI

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_HTTP_TIMEOUT_SEC=35

# Local vLLM Configuration (Alternative to Gemini)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_MODEL=gemma4-31b
VLLM_TIMEOUT_SEC=180
VLLM_MAX_TOKENS=8192

# Continuous Batching & Concurrency
LAM_AI_MAX_CONCURRENCY=8
LAM_BATCH_SIZE=10

# Database Configuration (Read-only UzAssets PostgreSQL DB)
REAL_DB_HOST=127.0.0.1
REAL_DB_PORT=5432
REAL_DB_USER=read-user
REAL_DB_PASSWORD=your_db_password_here
REAL_DB_NAME=uzassetsdb
REAL_DB_SCHEMA=public

# SSH Tunnel (if connecting remotely)
REAL_DB_USE_SSH_TUNNEL=false
DB_SSH_HOST=
DB_SSH_PORT=22
DB_SSH_USERNAME=
DB_SSH_PRIVATE_KEY_PATH=
DB_SSH_PASSPHRASE=
DB_LOCAL_BIND_PORT=15432

# Local SQLite Storage Path for Run Tracking
LAM_STORAGE_PATH=var/product_matching.sqlite3
